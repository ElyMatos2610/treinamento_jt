algoritmo "alg01"

var
idade: inteiro
nome: caractere

inicio

escreval ("Qual a sua idade?: ")
leia(idade)

escreval ("Qual o seu nome?: ")
leia(nome)


se (idade >= 18)  entao
   escreval ("Você é maior de Idade!")
senao
   escreval ("Você é menor de idade!")
fimse

escreval("")
escreval("Seu nome é: ", nome)
escreval("Sua idade é: ", idade)
fimalgoritmo

